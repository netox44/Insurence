@{
    ViewData["Title"] = "Contact & Support - HM Insurance";
}

<!-- Hero Section -->
<section class="hero-section position-relative" style="min-height: 75vh;">
    <div class="hero-bg position-absolute top-0 start-0 w-100 h-100"
         style="background-image: url('/images/programs/insurance-Contact.jpg');
                background-size: cover;
                background-position: center;
                z-index: 1;">
    </div>

    <!-- Dark Overlay -->
    <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0, 0, 0, 0.6); z-index: 2;">
    </div>

    <div class="container position-relative" style="z-index: 3;">
        <div class="row align-items-center mt-5">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold text-white mb-4">We're Here to Assist You</h1>
                <p class="text-white mb-0">Have questions about your insurance plans, claims, or policies? Our dedicated support team is ready to help.</p>
            </div>
        </div>
    </div>
</section>

<!-- Contact Form -->
<section class="section-padding bg-white mt-5">
    <div class="container">
        @if (ViewBag.Message != null)
        {
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle fa-2x text-success me-3"></i>
                            <div>
                                <h5 class="alert-heading mb-1">Thank You!</h5>
                                <p class="mb-0">@ViewBag.Message</p>
                                @if (ViewBag.Name != null)
                                {
                                    <small class="text-muted">We've received your message, @ViewBag.Name, and will respond within 24 hours.</small>
                                }
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-white py-4">
                        <h3 class="mb-0"><i class="fas fa-envelope me-2 text-primary"></i>Contact Our Support Team</h3>
                        <p class="text-muted mb-0 mt-2">Fill out the form below for inquiries about your insurance policies, claims, or account issues. We’ll respond promptly.</p>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" action="/Query/Submit">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Full Name *</label>
                                    <input type="text" class="form-control" name="name" placeholder="Enter your full name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Email Address *</label>
                                    <input type="email" class="form-control" name="email" placeholder="Enter your email" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Inquiry Type *</label>
                                    <select class="form-select" name="category" required>
                                        <option value="">Select an option</option>
                                        <option value="claims">Claims Assistance</option>
                                        <option value="policy">Policy Questions</option>
                                        <option value="billing">Billing & Payments</option>
                                        <option value="technical">Technical Support</option>
                                        <option value="partnership">Partnership Inquiry</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Subject *</label>
                                    <input type="text" class="form-control" name="subject" placeholder="Brief description of your inquiry" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Message *</label>
                                    <textarea class="form-control" name="message" rows="6" placeholder="Please provide details regarding your inquiry..." required></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Attachments (Optional)</label>
                                    <input type="file" class="form-control" multiple>
                                    <div class="form-text">Attach documents, screenshots, or forms to help us assist you faster. Maximum file size: 5MB</div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="newsletter" name="newsletter">
                                        <label class="form-check-label" for="newsletter">
                                            Subscribe to our newsletter for updates on new insurance plans and offers
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="fas fa-paper-plane me-2"></i>Send Message
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary btn-lg ms-2">
                                        <i class="fas fa-redo me-2"></i>Reset Form
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Contact Information -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0"><i class="fas fa-headset me-2"></i>Support Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <i class="fas fa-envelope text-black fa-lg"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Email Support</h6>
                                <p class="text-black mb-1">support@hminsurance.com</p>
                                <small class="text-black">Our dedicated email support</small>
                            </div>
                        </div>
                        <div class="d-flex mb-4">
                            <div class="flex-shrink-0">
                                <i class="fas fa-phone text-white fa-lg"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Phone Support</h6>
                                <p class="text-black mb-1">+1 (555) 123-4567</p>
                                <small class="text-black">Mon-Fri, 9:00 AM - 6:00 PM EST</small>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="fas fa-clock text-white fa-lg"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="mb-1">Response Time</h6>
                                <p class="text-black mb-1">Within 24 hours</p>
                                <small class="text-black">Fast and reliable service</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Resources -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0"><i class="fas fa-question-circle me-2"></i>Quick Resources</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="/Home/HelpCentre" class="btn btn-outline-primary text-start">
                                <i class="fas fa-search me-2"></i>FAQ & Knowledge Base
                            </a>
                            <a href="/User/MyDonations" class="btn btn-outline-primary text-start">
                                <i class="fas fa-file-alt me-2"></i>Insurance History
                            </a>
                            <a href="/Program" class="btn btn-outline-primary text-start">
                                <i class="fas fa-project-diagram me-2"></i>Policies
                            </a>
                            <a href="#" class="btn btn-outline-primary text-start">
                                <i class="fas fa-file-alt me-2"></i>Policy Documents
                            </a>
                        </div>
                    </div>
                </div>

                <!-- System Status -->
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0"><i class="fas fa-heartbeat me-2"></i>System Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Claims Processing</span>
                            <span class="badge bg-success">Operational</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Policy Management</span>
                            <span class="badge bg-success">Operational</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Customer Support</span>
                            <span class="badge bg-success">Operational</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="section-padding bg-light pt-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Frequently Asked Questions</h2>
                <p class="lead text-muted">Quick answers to your insurance-related questions</p>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="accordion" id="faqAccordion">
                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                <i class="fas fa-file-invoice text-primary me-3"></i>
                                How do I update my payment information for my policy?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You can update your payment information by logging into your account, going to "My Policies," and selecting "Payment Methods." From there, you can securely add, remove, or update your payment details.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                <i class="fas fa-receipt text-primary me-3"></i>
                                How can I get a receipt for my insurance premiums?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Receipts are generated automatically and emailed to you after each payment. You can also access all receipts in your account under "My Policies" for record-keeping and tax purposes.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                <i class="fas fa-undo text-primary me-3"></i>
                                Can I modify or cancel my existing policy?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, policy changes can be made anytime through your account. Log in, go to "My Policies," and you can modify coverage, pause payments, or cancel the policy according to terms and conditions.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .form-control, .form-select {
        border-radius: var(--border-radius-sm);
        border: 2px solid #E2E8F0;
        padding: 0.875rem 1rem;
        transition: var(--transition);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(13, 138, 188, 0.1);
        }

    .accordion-button:not(.collapsed) {
        background-color: var(--primary-light);
        color: var(--primary-color);
        font-weight: 600;
    }

    .accordion-button:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 138, 188, 0.1);
        border-color: var(--primary-color);
    }
</style>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const submitBtn = form.querySelector('button[type="submit"]');
            const fileInput = form.querySelector('input[type="file"]');

            // Form submission handling
            form.addEventListener('submit', function(e) {
                const subject = form.querySelector('select[name="category"]');
                const message = form.querySelector('textarea[name="message"]');

                if (!subject.value) {
                    e.preventDefault();
                    showValidationError('Please select a category for your inquiry.');
                    subject.focus();
                    return;
                }

                if (!message.value.trim()) {
                    e.preventDefault();
                    showValidationError('Please enter a detailed message.');
                    message.focus();
                    return;
                }

                submitBtn.classList.add('loading');
                submitBtn.disabled = true;

                setTimeout(() => {
                    submitBtn.classList.remove('loading');
                    submitBtn.disabled = false;
                }, 2000);
            });

            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const files = this.files;
                    const fileList = Array.from(files).map(file => file.name).join(', ');
                    if (fileList) {
                        const existingFileInfo = this.parentNode.querySelector('.file-info');
                        if (existingFileInfo) existingFileInfo.remove();
                        const fileInfo = document.createElement('div');
                        fileInfo.className = 'file-info mt-2 small text-muted';
                        fileInfo.textContent = `Selected: ${fileList}`;
                        this.parentNode.appendChild(fileInfo);
                    }
                });
            }

            function showValidationError(message) {
                const existingAlerts = document.querySelectorAll('.alert-danger');
                existingAlerts.forEach(alert => alert.remove());
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show';
                alertDiv.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                form.parentNode.insertBefore(alertDiv, form);
                setTimeout(() => { if (alertDiv.parentElement) alertDiv.remove(); }, 5000);
            }
        });
    </script>
}
