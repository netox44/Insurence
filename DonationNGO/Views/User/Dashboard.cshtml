@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="d-flex gap-2">
        <div class="d-flex gap-2">
            <a href="/User/ExportPdf" class="btn btn-primary">
                <i class="fas fa-file-pdf me-2"></i>Export PDF
            </a>
        </div>
        <a href="/User/Donate" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>New Insurance
        </a>
    </div>
</div>
<!-- Stats Row -->
<div class="row g-4 mb-4">
    <!-- Total Donated -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-shield-alt fa-2x text-primary"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h3 class="stat-number mb-0">$@ViewBag.TotalDonated</h3>
                    <div class="stat-label">Total Amount</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Total Donations -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-hand-holding-heart fa-2x text-success"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h3 class="stat-number mb-0">@ViewBag.TotalDonations</h3>
                    <div class="stat-label">Total Insurance</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Programs -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-project-diagram fa-2x text-warning"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h3 class="stat-number mb-0">@ViewBag.ActivePrograms</h3>
                    <div class="stat-label">Total Policies</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Donor Level -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <i class="fas fa-award fa-2x text-info"></i>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h3 class="stat-number mb-0">@ViewBag.DonorLevel</h3>
                    <div class="stat-label">Insurance Level</div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    <!-- Recent Donations -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Donations</h5>
                <a href="/User/MyDonations" class="btn btn-sm btn-outline-primary">View All</a>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Insurance</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (ViewBag.RecentDonations != null && ViewBag.RecentDonations.Count > 0)
                            {
                                foreach (var d in ViewBag.RecentDonations)
                                {
                                    <tr>
                                        <td>@d.Date.ToString("MMM dd, yyyy")</td>
                                        <td>@d.Program</td>
                                        <td>$@d.Amount</td>
                                        <td><span class="badge bg-primary">@d.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">
                                        No Insurance found.
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions + Impact -->
    <div class="col-lg-4">

        <!-- Quick Actions -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/User/Donate" class="btn btn-primary">
                        <i class="fas fa-donate me-2"></i>Make a Insurance
                    </a>
                    <a href="/User/Programs" class="btn btn-outline-primary">
                        <i class="fas fa-project-diagram me-2"></i>Browse Policy
                    </a>
                    <a href="/User/MyDonations" class="btn btn-outline-primary">
                        <i class="fas fa-question-circle me-2"></i>Insurance History
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
