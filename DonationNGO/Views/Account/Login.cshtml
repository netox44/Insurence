@model Insurence.Models.LoginViewModel
@{
    ViewData["Title"] = "Login - DonationNGO";
    Layout = "_LayoutPublic";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-white text-center py-4">
                    <a class="navbar-brand fw-bold text-primary fs-3" href="/">
                        <i class="fas fa-hands-helping me-2"></i>HM Insurance
                    </a>
                    <h4 class="mt-3 mb-0">Welcome Back</h4>
                    <p class="text-muted mb-0">Sign in to your account</p>
                </div>

                <div class="card-body p-4">
                    <!-- SUCCESS MESSAGE FROM REGISTRATION -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- ERROR SUMMARY -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>



                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                            <span class="text-danger small" asp-validation-for="Email"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                            <span class="text-danger small" asp-validation-for="Password"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </button>

                        <div class="text-center">
                            <a href="/Account/ForgotPassword" class="text-decoration-none">
                                Forgot your password?
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-white text-center py-3">
                    <p class="mb-0">
                        Don't have an account?
                        <a href="/Account/Register" class="fw-bold text-decoration-none">Sign up here</a>
                    </p>
                </div>
            </div>

            <!-- DEMO ACCOUNTS -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body text-center">
                    <h6 class="mb-3">Demo Accounts</h6>
                    <small class="text-muted d-block">User: user@demo.com / Pass: demo123</small>
                    <small class="text-muted d-block">Admin: admin@demo.com / Pass: admin123</small>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
