@model Insurence.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register - HM Insurance";
    Layout = "_LayoutPublic";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-lg border-0">

                <!-- HEADER -->
                <div class="card-header bg-white text-center py-4">
                    <a class="navbar-brand fw-bold text-primary fs-3" href="/">
                        <i class="fas fa-hands-helping me-2"></i>HM Insurance
                    </a>
                    <h4 class="mt-3 mb-0">Create Account</h4>
                    <p class="text-muted mb-0">Join our community of Insurance</p>
                </div>

                <!-- BODY -->
                <div class="card-body p-4">

                    <!-- SUCCESS MESSAGE -->
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    
                    <!-- ERROR SUMMARY -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <!-- First Name -->
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span class="text-danger small" asp-validation-for="FirstName"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span class="text-danger small" asp-validation-for="LastName"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-12">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span class="text-danger small" asp-validation-for="Email"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-12">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span class="text-danger small" asp-validation-for="Password"></span>
                                <div class="form-text">
                                    Must be at least 8 characters with numbers and letters.
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-12">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" />
                                <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                            </div>

                            <!-- Terms Checkbox -->
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="terms" required>
                                    <label class="form-check-label" for="terms">
                                        I agree to the <a href="#" class="text-decoration-none">Terms of Service</a>
                                        and <a href="#" class="text-decoration-none">Privacy Policy</a>.
                                    </label>
                                </div>
                            </div>

                            <!-- Submit -->
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="fas fa-user-plus me-2"></i> Create Account
                                </button>
                            </div>

                        </div>
                    </form>
                </div>

                <!-- FOOTER -->
                <div class="card-footer bg-white text-center py-3">
                    <p class="mb-0">
                        Already have an account?
                        <a href="/Account/Login" class="fw-bold text-decoration-none">
                            Sign in here
                        </a>
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
