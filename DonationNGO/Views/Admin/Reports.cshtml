@model Insurence.Models.ViewModels.ReportViewModel

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Reports & Analytics</h4>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportDonationsPdf", "Admin")" class="btn btn-outline-primary">
            <i class="fas fa-download me-2"></i>Export PDF
        </a>
        <a href="@Url.Action("Reports", "Admin")" class="btn btn-primary">
            <i class="fas fa-sync-alt me-2"></i>Refresh Data
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Report Type</label>
                <select class="form-select">
                    <option>Donation Summary</option>
                    <option>Program Performance</option>
                    <option>Donor Analytics</option>
                    <option>Financial Report</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Date Range</label>
                <select class="form-select">
                    <option>Last 7 days</option>
                    <option>Last 30 days</option>
                    <option>Last 90 days</option>
                    <option>Year to Date</option>
                    <option>Custom Range</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Program</label>
                <select class="form-select">
                    <option>All Programs</option>
                    @foreach (var p in Model.ProgramPerformances)
                    {
                        <option>@p.ProgramName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Format</label>
                <select class="form-select">
                    <option>Summary View</option>
                    <option>Detailed View</option>
                    <option>Charts Only</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Donation Trends</h5>
            </div>
            <div class="card-body">
                <canvas id="donationChart" style="height:300px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Key Metrics</h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total Donations</span>
                        <strong>@Model.TotalDonations.ToString("C")</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar" style="width:@Math.Min((Model.TotalDonations / 100000) * 100, 100)%"></div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Average Donation</span>
                        <strong>@Model.AverageDonation.ToString("C")</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width:@Math.Min((Model.AverageDonation / 100) * 100, 100)%"></div>
                    </div>
                </div>
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span>New Donors</span>
                        <strong>@Model.NewDonors</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width:@Math.Min((Model.NewDonors / 200.0) * 100, 100)%"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Success Rate</span>
                        <strong>@Model.SuccessRate.ToString("F1")%</strong>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width:@Math.Min(Model.SuccessRate, 100)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Program Performance</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Funds Raised</th>
                        <th>Goal</th>
                        <th>Completion</th>
                        <th>Donors</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ProgramPerformances)
                    {
                        <tr>
                            <td>@p.ProgramName</td>
                            <td>@p.FundsRaised.ToString("C")</td>
                            <td>@p.Goal.ToString("C")</td>
                            <td>
                                @{
                                    var completion = p.Goal > 0 ? (p.FundsRaised / p.Goal) * 100 : 0;
                                }
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" style="width:@Math.Min(completion, 100)%"></div>
                                </div>
                                <small>@Math.Round(completion, 1)%</small>
                            </td>
                            <td>@p.Donors</td>
                            <td>
                                <span class="badge @(p.Status == "Active" ? "bg-success" : "bg-warning")">@p.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('donationChart').getContext('2d');
        const donationChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [@string.Join(",", Model.DonationTrends.Select(d => $"'{d.Date:MM/dd}'"))],
                datasets: [{
                    label: 'Donations',
                    data: [@string.Join(",", Model.DonationTrends.Select(d => d.Amount))],
                    fill: false,
                    borderColor: 'rgb(54, 162, 235)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
