@model IEnumerable<Insurence.Models.Gallery>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Manage Gallery";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Manage Gallery</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="fas fa-upload me-2"></i>Upload Images
    </button>
</div>

<!-- Display success/error messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Upload Area -->
<div class="card mb-4">
    <div class="card-body text-center py-5">
        <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
        <h5>Drag and drop images here</h5>
        <p class="text-muted mb-3">or click the button below to browse files</p>
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#uploadModal">
            <i class="fas fa-folder-open me-2"></i>Browse Files
        </button>
    </div>
</div>

<!-- Gallery Grid -->
<div class="row g-3">
    @foreach (var img in Model)
    {
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <div class="card">
                <img src="~/@img.ImageUrl" class="card-img-top" alt="Gallery Image">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">@img.UploadDate.ToString("MMM dd, yyyy")</small>
                        <div class="btn-group">
                            <!-- Delete Button -->
                            <a asp-action="DeleteGallery" asp-route-id="@img.Id" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(img.Description))
                    {
                        <p class="mt-2 small text-muted">@img.Description</p>
                    }
                    <span class="badge bg-secondary">@img.Category</span>
                </div>
            </div>
        </div>
    }
</div>

<!-- Upload Modal -->
<form asp-action="UploadGallery" method="post" enctype="multipart/form-data">
    <div class="modal fade" id="uploadModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Images</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Images</label>
                        <input type="file" class="form-control" name="imageFiles" multiple accept="image/*">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="category">
                            <option>Program Activities</option>
                            <option>Success Stories</option>
                            <option>Events</option>
                            <option>Team</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea class="form-control" name="description" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload Images</button>
                </div>
            </div>
        </div>
    </div>
</form>
