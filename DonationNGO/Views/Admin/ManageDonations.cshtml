@model Insurence.Models.ViewModels.DonationFilterViewModel

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Manage Policies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportDonationsPdf", "Admin", new {
        searchTerm = Model.SearchTerm,
        status = Model.Status,
        program = Model.Program,
        dateRange = Model.DateRange
    })" class="btn btn-outline-primary">
    <i class="fas fa-download me-2"></i>Export
</a>
        <a href="/Admin/AddDonation" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Add Policies
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Policies Records</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>No#</th>
                        <th>Contact</th>
                        <th>Policies</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Donations != null && Model.Donations.Any())
                    {
                        foreach (var donation in Model.Donations)
                        {
                            <tr>
                                <td>#DON-@donation.Id.ToString("D6")</td>
                                <td>@donation.DonorName</td>
                                <td>@donation.Program</td>
                                <td>@donation.Amount.ToString("C")</td>
                                <td>@donation.Date.ToString("MMM dd, yyyy")</td>
                                <td>@donation.PaymentMethod</td>
                                <td>
                                    @if (donation.Status == "Completed")
                                    {
                                        <span class="badge bg-success">@donation.Status</span>
                                    }
                                    else if (donation.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">@donation.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@donation.Status</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Admin/DonationDetails/@donation.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center">No Policies found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
