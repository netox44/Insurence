@model Insurence.Models.ViewModels.ProgramFilterViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Manage Programs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Manage Programs</h4>

    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProgramModal">
        <i class="fas fa-plus me-2"></i>Add New Program
    </button>
</div>

<!-- ======================= FILTER SECTION ======================= -->
<form method="get" asp-action="ManagePrograms" class="card p-3 mb-4">
    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name">
        </div>

        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select name="category" class="form-select">
                <option value="All" @@(Model.Category= ="All" ? "selected" : "" )>All</option>
                <option value="Education" @@(Model.Category= ="Education" ? "selected" : "" )>Education</option>
                <option value="Healthcare" @@(Model.Category= ="Healthcare" ? "selected" : "" )>Healthcare</option>
                <option value="Environment" @@(Model.Category= ="Environment" ? "selected" : "" )>Environment</option>
                <option value="Disaster Relief" @@(Model.Category= ="Disaster Relief" ? "selected" : "" )>Disaster Relief</option>
            </select>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button class="btn btn-primary w-100"><i class="fas fa-search me-2"></i>Apply Filters</button>
        </div>
    </div>
</form>

<!-- ======================= PROGRAM CARDS ======================= -->
<div class="row g-4">
    @foreach (var program in Model.Programs)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                <img src="@Url.Content("~/" + program.ImageUrl)"
                     class="card-img-top"
                     alt="@program.ProgramName"
                     style="height:200px;object-fit:cover;">

                <div class="card-body">
                    <h5 class="card-title">@program.ProgramName</h5>

                    <p class="text-muted">@program.Description</p>

                    <div class="progress mb-3">
                        @{
                            var progress = program.FundingGoal > 0
                            ? (int)((program.AmountRaised / program.FundingGoal) * 100)
                            : 0;
                        }
                        <div class="progress-bar" style="width:@progress%"></div>
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-3">
                        <span>$@program.AmountRaised raised</span>
                        <span>$@program.FundingGoal goal</span>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="EditProgram" asp-route-id="@program.Id"
                           class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>

                        <form asp-action="DeleteProgram" asp-route-id="@program.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this program?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ======================= PAGINATION ======================= -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="ManagePrograms"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-category="@Model.Category">Previous</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.Page == i ? "active" : "")">
                    <a class="page-link"
                       asp-action="ManagePrograms"
                       asp-route-page="@i"
                       asp-route-search="@Model.Search"
                       asp-route-category="@Model.Category">@i</a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="ManagePrograms"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-category="@Model.Category">Next</a>
            </li>
        </ul>
    </nav>
}

<!-- ======================= ADD PROGRAM MODAL ======================= -->
<div class="modal fade" id="addProgramModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form asp-action="CreateProgram" method="post" enctype="multipart/form-data">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Program Name</label>
                            <input name="ProgramName" class="form-control" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <select name="Category" class="form-select" required>
                                <option value="">Select Category</option>
                                <option>Education</option>
                                <option>Healthcare</option>
                                <option>Environment</option>
                                <option>Disaster Relief</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Funding Goal ($)</label>
                            <input name="FundingGoal" type="number" class="form-control" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Duration (months)</label>
                            <input name="DurationMonths" type="number" class="form-control" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Program Image</label>
                            <input name="programImage" type="file" class="form-control">
                        </div>
                    </div>

                    <div class="modal-footer mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Create Program</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
