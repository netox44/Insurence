@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">
    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xxl-3 col-xl-4 col-md-6 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="fas fa-donate fa-2x text-primary"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h3 class="stat-number mb-0">$@ViewBag.TotalDonations</h3>
                        <div class="stat-label">Total Amount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-xl-4 col-md-6 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="fas fa-users fa-2x text-success"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h3 class="stat-number mb-0">@ViewBag.DonationCount</h3>
                        <div class="stat-label">Total Customer</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-xl-4 col-md-6 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="fas fa-project-diagram fa-2x text-warning"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h3 class="stat-number mb-0">@ViewBag.ActivePrograms</h3>
                        <div class="stat-label">Active Policies</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3 col-xl-4 col-md-6 col-sm-6">
            <div class="stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <i class="fas fa-users fa-2x text-primary"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h3 class="stat-number mb-0">@ViewBag.TotalNGOs</h3>
                        <div class="stat-label">Total Insurence</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Activity -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Activity</h5>
                    <a href="/Admin/ManageDonations" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Costumer</th>
                                    <th>Insurance</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentDonations != null)
                                {
                                    foreach (var item in ViewBag.RecentDonations)
                                    {
                                        <tr>
                                            <td>@item.DonorName</td>
                                            <td>@item.Program</td>
                                            <td>$@item.Amount</td>
                                            <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (item.Status == "Completed")
                                                {
                                                    <span class="badge bg-success">Completed</span>
                                                }
                                                else if (item.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@item.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No donations found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Admin/ManageNGOs" class="btn btn-outline-primary text-start">
                            <i class="fas fa-building me-2"></i>Manage Insurance
                        </a>
                        <a href="/Admin/ManageDonations" class="btn btn-outline-primary text-start">
                            <i class="fas fa-donate me-2"></i>Manage Policies
                        </a>
                        <a href="/Admin/ManageUsers" class="btn btn-outline-primary text-start">
                            <i class="fas fa-project-diagram me-2"></i>Manage User
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div

