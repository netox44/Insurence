@model Insurence.Models.Ngo

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Delete Insurance";
}

<div class="alert alert-danger">
    Are you sure you want to delete <strong>@Model.Name</strong>?
</div>

<form asp-action="DeleteNGO" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="ManageNGOs" class="btn btn-secondary">Cancel</a>
</form>
