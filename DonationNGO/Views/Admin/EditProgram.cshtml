@model Insurence.Models.prmodel
@{
    ViewData["Title"] = "Edit Program";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Edit Program</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditProgram" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <!-- Program Name -->
                            <div class="col-md-6">
                                <label asp-for="ProgramName" class="form-label">Program Name *</label>
                                <input asp-for="ProgramName" class="form-control" required>
                                <span asp-validation-for="ProgramName" class="text-danger"></span>
                            </div>

                            <!-- Category -->
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label">Category *</label>
                                <select asp-for="Category" class="form-select" required>
                                    <option value="">Select Category</option>
                                    <option value="Education">Education</option>
                                    <option value="Healthcare">Healthcare</option>
                                    <option value="Environment">Environment</option>
                                    <option value="Disaster Relief">Disaster Relief</option>
                                    <option value="Poverty">Poverty</option>
                                    <option value="Food">Food</option>
                                    <option value="Shelter">Shelter</option>
                                    <option value="Emergency">Emergency</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Completed">Completed</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <!-- Funding Goal -->
                            <div class="col-md-6">
                                <label asp-for="FundingGoal" class="form-label">Funding Goal ($) *</label>
                                <input asp-for="FundingGoal" type="number" step="0.01" class="form-control" required>
                                <span asp-validation-for="FundingGoal" class="text-danger"></span>
                            </div>

                            <!-- Duration -->
                            <div class="col-md-6">
                                <label asp-for="DurationMonths" class="form-label">Duration (Months)</label>
                                <input asp-for="DurationMonths" type="number" class="form-control">
                                <span asp-validation-for="DurationMonths" class="text-danger"></span>
                            </div>

                            <!-- Amount Raised (Readonly) -->
                            <div class="col-md-6">
                                <label asp-for="AmountRaised" class="form-label">Amount Raised ($)</label>
                                <input asp-for="AmountRaised" type="number" step="0.01" class="form-control" readonly>
                                <small class="text-muted">This field is automatically calculated from donations</small>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Description *</label>
                                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <!-- Current Image -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Current Image</label>
                                <div class="mb-3">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="~/@Model.ImageUrl" alt="Program Image"
                                             class="img-thumbnail" style="max-height: 200px; max-width: 100%;">
                                        <div class="mt-2">
                                            <small class="text-muted">Current image: @Model.ImageUrl</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle me-2"></i>No image currently set for this program.
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- New Image Upload -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Upload New Image</label>
                                <input type="file" name="programImage" class="form-control" accept="image/*">
                                <small class="text-muted">
                                    Leave empty to keep current image. Supported formats: JPG, PNG, GIF, WEBP
                                </small>
                            </div>

                            <!-- Progress Display -->
                            @if (Model.FundingGoal > 0)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-bold">Funding Progress</label>
                                    @{
                                        var progress = (Model.AmountRaised / Model.FundingGoal) * 100;
                                        var progressWidth = progress > 100 ? 100 : progress;
                                    }
                                    <div class="progress mb-2" style="height: 12px;">
                                        <div class="progress-bar @(progress >= 100 ? "bg-success" : "bg-primary")"
                                             style="width: @progressWidth%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm">
                                        <span>@progress.ToString("F1")% Complete</span>
                                        <span>$@Model.AmountRaised of $@Model.FundingGoal</span>
                                    </div>
                                </div>
                            }

                            <!-- Action Buttons -->
                            <div class="col-12 mt-4">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Update Program
                                    </button>
                                    <a asp-action="ManagePrograms" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-left me-2"></i>Back to Programs
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Client-side validation enhancement
        $(document).ready(function() {
            // Add Bootstrap styling to validation messages
            $('form').validate({
                highlight: function(element) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element) {
                    $(element).removeClass('is-invalid');
                },
                errorElement: 'div',
                errorClass: 'invalid-feedback'
            });

            // Image preview for new image upload
            $('input[type="file"]').change(function(e) {
                var file = e.target.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        // Remove existing preview if any
                        $('.image-preview').remove();

                        // Create new preview
                        var preview = $('<div class="image-preview mt-3">' +
                            '<label class="form-label fw-bold">New Image Preview:</label>' +
                            '<img src="' + e.target.result + '" class="img-thumbnail" style="max-height: 200px; max-width: 100%;">' +
                            '</div>');

                        $(this).closest('.col-12').append(preview);
                    }.bind(this);
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}