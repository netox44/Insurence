@using Insurence.Models
@model prmodel
@{
    ViewData["Title"] = "Program Details";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Program Details</h4>
                    <a href="/Admin/ManagePrograms" class="btn btn-outline-primary btn-sm">Back to List</a>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="text-center mb-4">
                            <img src="/@Model.ImageUrl" alt="@Model.ProgramName" class="img-fluid rounded" style="max-height: 300px;">
                        </div>
                    }
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <h6>Basic Information</h6>
                            <p><strong>Name:</strong> @Model.ProgramName</p>
                            <p><strong>Category:</strong> <span class="badge bg-primary">@Model.Category</span></p>
                            <p><strong>Status:</strong> 
                                <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Completed" ? "bg-info" : "bg-warning")">@Model.Status</span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6>Funding Information</h6>
                            <p><strong>Goal:</strong> $@Model.FundingGoal</p>
                            <p><strong>Raised:</strong> $@Model.AmountRaised</p>
                            <p><strong>Duration:</strong> @Model.DurationMonths months</p>
                        </div>
                        <div class="col-12">
                            <h6>Description</h6>
                            <p class="text-muted">@Model.Description</p>
                        </div>
                        
                        <!-- Progress Bar -->
                        <div class="col-12">
                            @{
                                var progress = Model.FundingGoal > 0 ? (Model.AmountRaised / Model.FundingGoal) * 100 : 0;
                            }
                            <div class="progress mb-2" style="height: 12px;">
                                <div class="progress-bar" style="width: @progress%"></div>
                            </div>
                            <div class="d-flex justify-content-between text-sm">
                                <span>@progress.ToString("F1")% Complete</span>
                                <span>$@Model.AmountRaised of $@Model.FundingGoal</span>
                            </div>
                        </div>
                        
                        <div class="col-12">
                            <div class="d-flex gap-2">
                                <a href="/Admin/EditProgram/@Model.Id" class="btn btn-primary">Edit</a>
                                <a href="/Admin/DeleteProgram/@Model.Id" class="btn btn-outline-danger">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>