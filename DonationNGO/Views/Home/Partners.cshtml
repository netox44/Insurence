@{
    ViewData["Title"] = "Our Partners - SecureLife Insurance";
}
<!-- Hero Section -->
<section class="position-relative text-white"
         style="
        background-image: url('/images/programs/Life Insurance.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 75vh;
    ">

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0,0,0,0.55);">
    </div>

    <!-- Centered Content -->
    <div class="position-relative d-flex align-items-center justify-content-center text-center"
         style="min-height: 75vh;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4 mx-auto">
                Our Partners
            </h1>
            <p class="mb-0 mx-auto">
                Collaborating with leading organizations to provide trusted insurance solutions
            </p>
        </div>
    </div>
</section>
<!-- Partners Grid -->
<section class="section-padding bg-white pt-5 pb-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Strategic Partnerships</h2>
                <p class="lead text-muted">Working with industry leaders to deliver comprehensive coverage and exceptional service</p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="partner-logo mb-4">
                            <i class="fas fa-hospital fa-4x text-primary"></i>
                        </div>
                        <h5 class="card-title">MediCare Partners</h5>
                        <p class="card-text text-muted">Healthcare partner ensuring smooth health insurance claim settlements and hospital networks.</p>
                        <div class="mt-3">
                            <span class="badge bg-primary-light text-primary">Since 2013</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="partner-logo mb-4">
                            <i class="fas fa-car fa-4x text-primary"></i>
                        </div>
                        <h5 class="card-title">AutoSecure Alliance</h5>
                        <p class="card-text text-muted">Vehicle insurance partner providing roadside assistance and fast claim processing.</p>
                        <div class="mt-3">
                            <span class="badge bg-primary-light text-primary">Since 2015</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body p-4">
                        <div class="partner-logo mb-4">
                            <i class="fas fa-home fa-4x text-primary"></i>
                        </div>
                        <h5 class="card-title">SafeHome Network</h5>
                        <p class="card-text text-muted">Property insurance partner ensuring reliable coverage and claims support for homeowners.</p>
                        <div class="mt-3">
                            <span class="badge bg-primary-light text-primary">Since 2017</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Corporate Partners -->
        <div class="row mb-5">
            <div class="col-12">
                <h3 class="text-center mb-5">Corporate Partners</h3>
                <div class="row g-4 align-items-center justify-content-center">
                    <div class="col-lg-2 col-md-3 col-4 text-center">
                        <div class="bg-primary-light rounded-3 p-4 h-100 d-flex align-items-center justify-content-center">
                            <i class="fas fa-building fa-2x text-primary"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-500">LifeSecure Ltd.</p>
                    </div>
                    <div class="col-lg-2 col-md-3 col-4 text-center">
                        <div class="bg-primary-light rounded-3 p-4 h-100 d-flex align-items-center justify-content-center">
                            <i class="fas fa-industry fa-2x text-primary"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-500">AutoProtect Inc.</p>
                    </div>
                    <div class="col-lg-2 col-md-3 col-4 text-center">
                        <div class="bg-primary-light rounded-3 p-4 h-100 d-flex align-items-center justify-content-center">
                            <i class="fas fa-home fa-2x text-primary"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-500">HomeGuard Corp.</p>
                    </div>
                    <div class="col-lg-2 col-md-3 col-4 text-center">
                        <div class="bg-primary-light rounded-3 p-4 h-100 d-flex align-items-center justify-content-center">
                            <i class="fas fa-hospital fa-2x text-primary"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-500">MediPartners</p>
                    </div>
                    <div class="col-lg-2 col-md-3 col-4 text-center">
                        <div class="bg-primary-light rounded-3 p-4 h-100 d-flex align-items-center justify-content-center">
                            <i class="fas fa-shield-alt fa-2x text-primary"></i>
                        </div>
                        <p class="mt-2 mb-0 fw-500">Global Insurance Group</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Partnership Benefits -->
<section class="section-padding bg-light pt-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Why Partner With Us?</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-3 p-3 d-inline-flex mb-3">
                        <i class="fas fa-hand-holding-usd fa-2x"></i>
                    </div>
                    <h5>Financial Strength</h5>
                    <p class="text-muted mb-0">Collaborate with a financially robust insurer for secure, reliable coverage solutions.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-3 p-3 d-inline-flex mb-3">
                        <i class="fas fa-globe fa-2x"></i>
                    </div>
                    <h5>Global Network</h5>
                    <p class="text-muted mb-0">Access a wide network of hospitals, garages, and service centers worldwide.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-3 p-3 d-inline-flex mb-3">
                        <i class="fas fa-user-shield fa-2x"></i>
                    </div>
                    <h5>Trusted Reputation</h5>
                    <p class="text-muted mb-0">Partner with a brand recognized for reliability, transparency, and excellent customer service.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-3 p-3 d-inline-flex mb-3">
                        <i class="fas fa-handshake fa-2x"></i>
                    </div>
                    <h5>Strategic Collaboration</h5>
                    <p class="text-muted mb-0">Align with an insurer committed to innovation, compliance, and mutual growth.</p>
                </div>
            </div>
        </div>
    </div>
</section>