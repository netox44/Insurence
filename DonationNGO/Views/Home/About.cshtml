@{
    ViewData["Title"] = "About Us - HM Insurance";
}
<!-- Hero Section -->
<section class="position-relative text-white"
         style="
        background-image: url('/images/programs/insurance-About.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 75vh;
    ">

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0,0,0,0.55);">
    </div>

    <!-- Centered Content -->
    <div class="position-relative d-flex align-items-center justify-content-center text-center"
         style="min-height: 75vh;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4 mx-auto">
                Protecting What Matters Most
            </h1>
            <p class="mb-0 mx-auto">
                A trusted insurance partner delivering security, reliability, and peace of mind since 2010
            </p>
        </div>
    </div>
</section>
<!-- Mission & Vision -->
<section class="section-padding bg-white mt-5 pb-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <i class="fas fa-bullseye fa-3x text-primary mb-4"></i>
                        <h3 class="h4 mb-3">Our Mission</h3>
                        <p class="text-muted">
                            To provide reliable, affordable, and innovative insurance solutions that protect individuals,
                            families, and businesses while delivering exceptional customer service and peace of mind.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <i class="fas fa-eye fa-3x text-primary mb-4"></i>
                        <h3 class="h4 mb-3">Our Vision</h3>
                        <p class="text-muted">
                            To be a trusted insurance leader recognized for integrity, innovation, and commitment to
                            safeguarding what matters most in every stage of life.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Timeline -->
<section class="section-padding bg-light mt-3">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-5 pt-3">Our Journey</h2>
                <p class="lead text-muted">Key milestones in building trust and protection</p>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="timeline">
                    <div class="timeline-item mb-5">
                        <div class="timeline-date">2010</div>
                        <div class="timeline-content card shadow-sm">
                            <div class="card-body">
                                <h5>Company Founded</h5>
                                <p class="mb-0">
                                    Established with a mission to provide reliable and transparent insurance solutions
                                    for individuals and businesses.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-date">2013</div>
                        <div class="timeline-content card shadow-sm">
                            <div class="card-body">
                                <h5>First Insurance Products Launched</h5>
                                <p class="mb-0">
                                    Introduced life and general insurance plans designed to meet the needs of growing families.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-date">2016</div>
                        <div class="timeline-content card shadow-sm">
                            <div class="card-body">
                                <h5>Market Expansion</h5>
                                <p class="mb-0">
                                    Expanded operations nationwide, serving thousands of policyholders with dedicated support.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-date">2020</div>
                        <div class="timeline-content card shadow-sm">
                            <div class="card-body">
                                <h5>Customer Trust & Resilience</h5>
                                <p class="mb-0">
                                    Supported customers during challenging times with fast claims processing and flexible policies.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-date">2024</div>
                        <div class="timeline-content card shadow-sm">
                            <div class="card-body">
                                <h5>Digital Innovation</h5>
                                <p class="mb-0">
                                    Launched a secure digital platform for online policy management, claims, and customer services.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Team Section -->
<section class="section-padding bg-white pt-5 pd-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Our Leadership</h2>
                <p class="lead text-muted">
                    Meet the experienced professionals guiding our insurance services with integrity and expertise
                </p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <img src="/images/programs/testimonials-1.jpg" class="card-img-top" alt="Sarah Johnson">
                    <div class="card-body text-center">
                        <h5 class="card-title mb-1">Sarah Johnson</h5>
                        <p class="text-muted mb-3">Chief Executive Officer</p>
                        <p class="card-text text-sm">
                            20+ years of leadership experience in the insurance and financial services industry.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <img src="/images/programs/testimonials-2.jpg" class="card-img-top" alt="Michael Chen">
                    <div class="card-body text-center">
                        <h5 class="card-title mb-1">Michael Chen</h5>
                        <p class="text-muted mb-3">Chief Operations Officer</p>
                        <p class="card-text text-sm">
                            Oversees policy operations, claims management, and customer service excellence.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <img src="/images/programs/testimonials-3.jpg" class="card-img-top" alt="Maria Rodriguez">
                    <div class="card-body text-center">
                        <h5 class="card-title mb-1">Maria Rodriguez</h5>
                        <p class="text-muted mb-3">Chief Financial Officer</p>
                        <p class="card-text text-sm">
                            Leads financial strategy, risk management, and regulatory compliance.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <img src="/images/programs/testimonials-4.jpg" class="card-img-top" alt="David Kim">
                    <div class="card-body text-center">
                        <h5 class="card-title mb-1">David Kim</h5>
                        <p class="text-muted mb-3">Chief Technology Officer</p>
                        <p class="card-text text-sm">
                            Drives digital innovation, cybersecurity, and modern insurance technology platforms.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    .timeline {
        position: relative;
        padding-left: 2rem;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, var(--primary-color) 0%, var(--primary-light) 100%);
            border-radius: 2px;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 3rem;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -2.4rem;
            top: 0.5rem;
            width: 1rem;
            height: 1rem;
            background: var(--primary-color);
            border-radius: 50%;
            border: 3px solid var(--white);
            box-shadow: 0 0 0 3px var(--primary-color);
        }

    .timeline-date {
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
        font-size: 1.1rem;
    }
</style>