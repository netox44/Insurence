@{
    ViewData["Title"] = "Help Centre - SecureLife Insurance";
}
<!-- Hero Section -->
<section class="position-relative text-white"
         style="
        background-image: url('/images/programs/Health Insurance.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 75vh;
    ">

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0,0,0,0.55);">
    </div>

    <!-- Centered Content -->
    <div class="position-relative d-flex align-items-center justify-content-center text-center"
         style="min-height: 75vh;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4 mx-auto">
                Help Centre
            </h1>
            <p class="mb-0 mx-auto">
                Get answers to your insurance questions and access policy & claims support
            </p>
        </div>
    </div>
</section>
<!-- Search Section -->
<section class="section-padding bg-light pt-5 pb-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <i class="fas fa-search fa-3x text-primary mb-3"></i>
                            <h3>How can we assist you?</h3>
                        </div>
                        <div class="input-group input-group-lg">
                            <input type="text" class="form-control" placeholder="Search policies, claims, or support...">
                            <button class="btn btn-primary" type="button">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="section-padding bg-white pt-5 pb-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Frequently Asked Questions</h2>
                <p class="lead text-muted">Quick answers to common insurance-related questions</p>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="accordion" id="faqAccordion">

                    <!-- Policy FAQs -->
                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                <i class="fas fa-file-contract text-primary me-3"></i>
                                How do I purchase an insurance policy?
                            </button>
                        </h2>
                        <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                You can purchase an insurance policy online by selecting your desired coverage,
                                filling in your personal details, and completing the payment process.
                                Our advisors are also available to assist you.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                <i class="fas fa-shield-alt text-primary me-3"></i>
                                What types of insurance do you offer?
                            </button>
                        </h2>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                We offer a wide range of insurance solutions including life, health,
                                motor, and property insurance tailored to your needs.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                <i class="fas fa-lock text-primary me-3"></i>
                                Is my personal and payment information secure?
                            </button>
                        </h2>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. We use advanced encryption and secure payment gateways to ensure
                                your personal and financial information remains protected at all times.
                            </div>
                        </div>
                    </div>

                    <!-- Account FAQs -->
                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                <i class="fas fa-user text-primary me-3"></i>
                                How do I create a customer account?
                            </button>
                        </h2>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Click on the "Register" option, provide your details, and verify your email address.
                                Once registered, you can manage your policies and claims online.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                <i class="fas fa-key text-primary me-3"></i>
                                How can I reset my account password?
                            </button>
                        </h2>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Use the "Forgot Password" option on the login page.
                                A secure password reset link will be sent to your registered email address.
                            </div>
                        </div>
                    </div>

                    <!-- Claims FAQs -->
                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                                <i class="fas fa-file-invoice-dollar text-primary me-3"></i>
                                How do I file an insurance claim?
                            </button>
                        </h2>
                        <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Claims can be submitted online through your customer dashboard or by contacting
                                our claims support team. Required documents will be guided step-by-step.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border-0 shadow-sm mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq7">
                                <i class="fas fa-sync-alt text-primary me-3"></i>
                                Can I modify or cancel my insurance policy?
                            </button>
                        </h2>
                        <div id="faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes, policy modifications or cancellations can be requested through your account
                                or by contacting our customer support team, subject to policy terms.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
