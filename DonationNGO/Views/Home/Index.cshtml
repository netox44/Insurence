@{
    ViewData["Title"] = "SecureLife Insurance - Protect What Matters";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-80">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="fas fa-shield-alt"></i>
                        <span>Trusted by 50K+ policyholders worldwide</span>
                    </div>
                    <h1 class="display-4 fw-bold mb-4">
                        Protection You Can Trust,
                        <span class="text-gradient">Security for Life</span>
                    </h1>
                    <p class="lead mb-5">
                        Comprehensive insurance solutions designed to protect your life, health, vehicle,
                        and property—giving you confidence and peace of mind at every stage of life.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="/User/Donate" class="btn btn-primary btn-lg">
                            <i class="fas fa-file-contract me-2"></i>Make a Insurance
                        </a>
                        <a href="/Home/About" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-play-circle me-2"></i>Learn More
                        </a>
                    </div>
                    <div class="mt-5 d-flex flex-wrap gap-4">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-circle p-2 me-3">
                                <i class="fas fa-lock"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">Secure Coverage</h6>
                                <small class="text-muted">Data & Payments Protected</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="bg-accent text-white rounded-circle p-2 me-3">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <h6 class="mb-0">24/7 Support</h6>
                                <small class="text-muted">Claims Assistance</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="position-relative">
                    <div class="card card-gradient p-4 position-absolute top-0 start-0" style="width: 200px; z-index: 3; transform: translate(-20px, -20px);">
                        <div class="text-center">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <h4 class="mb-1">50K+</h4>
                            <small>Active Clients</small>
                        </div>
                    </div>
                    <div class="card bg-white p-4 position-absolute bottom-0 end-0" style="width: 180px; z-index: 3; transform: translate(20px, 20px);">
                        <div class="text-center">
                            <i class="fas fa-globe-americas fa-2x text-primary mb-2"></i>
                            <h4 class="mb-1">25+</h4>
                            <small class="text-muted">Service Regions</small>
                        </div>
                    </div>
                    <div class="position-relative" style="z-index: 2;">
                        <div class="bg-gradient-primary rounded-3" style="height: 500px; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-shield-alt fa-6x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-number">$@ViewBag.TotalDonations+</div>
                    <div class="stat-label">Claims Paid</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-number">150+</div>
                    <div class="stat-label">Insurance Plans</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label">Satisfied Customers</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-number">25+</div>
                    <div class="stat-label">Operating Regions</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Our Insurance Solutions</h2>
                <p class="lead text-muted">
                    Tailored coverage designed to protect you, your family, and your assets
                </p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h4>Health Insurance</h4>
                    <p class="text-muted">
                        Comprehensive medical coverage with access to quality healthcare and cashless claims.
                    </p>
                    <div class="mt-3">
                        <span class="badge badge-primary">100K+ Covered</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h4>Life Insurance</h4>
                    <p class="text-muted">
                        Secure your family’s future with flexible life insurance plans and long-term protection.
                    </p>
                    <div class="mt-3">
                        <span class="badge badge-primary">50K+ Policies</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-car"></i>
                    </div>
                    <h4>Motor Insurance</h4>
                    <p class="text-muted">
                        Reliable vehicle coverage with fast claim settlements and roadside assistance.
                    </p>
                    <div class="mt-3">
                        <span class="badge badge-primary">75K+ Vehicles</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Impact Stories -->
<section class="impact-section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Customer Stories</h2>
                <p class="lead text-muted">
                    Real experiences from clients who trusted us when it mattered most
                </p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="impact-card">
                    <div class="impact-image">
                        <i class="fas fa-hospital"></i>
                    </div>
                    <div class="impact-content">
                        <h5>Cashless Medical Claim</h5>
                        <p class="text-muted mb-3">
                            Provided instant cashless hospitalization support during a medical emergency.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge badge-accent">Health</span>
                            <small class="text-muted">2024</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="impact-card">
                    <div class="impact-image">
                        <i class="fas fa-car-crash"></i>
                    </div>
                    <div class="impact-content">
                        <h5>Fast Motor Claim Settlement</h5>
                        <p class="text-muted mb-3">
                            Vehicle claim processed and settled within 48 hours after an accident.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge badge-accent">Motor</span>
                            <small class="text-muted">2024</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="impact-card">
                    <div class="impact-image">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <div class="impact-content">
                        <h5>Life Policy Support</h5>
                        <p class="text-muted mb-3">
                            Ensured financial stability for a family through timely life insurance benefits.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge badge-accent">Life</span>
                            <small class="text-muted">Ongoing</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="cta-content">
                    <h2 class="display-5 fw-bold mb-4">Ready to Secure Your Future?</h2>
                    <p class="lead mb-5">
                        Choose an insurance plan that fits your needs and protects what matters most.
                    </p>
                    <div class="d-flex flex-wrap gap-3 justify-content-center">
                        <a href="/User/Donate" class="btn btn-accent btn-lg">
                            <i class="fas fa-file-contract me-2"></i>Make a Insurance
                        </a>
                        <a href="/Home/About" class="btn btn-outline-light btn-lg">
                            <i class="fas fa-book-open me-2"></i>About Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
