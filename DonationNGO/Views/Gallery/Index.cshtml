<style>
    .gallery-grid {
        column-count: 3;
        column-gap: 1.5rem;
    }

    .gallery-item {
        break-inside: avoid;
        margin-bottom: 1.5rem;
    }

    .gallery-card {
        position: relative;
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--box-shadow);
        transition: var(--transition);
        background: var(--white);
    }

        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--box-shadow-lg);
        }

        .gallery-card img {
            width: 100%;
            height: auto;
            display: block;
            transition: transform 0.3s ease;
        }

        .gallery-card:hover img {
            transform: scale(1.05);
        }

    .gallery-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(transparent 40%, rgba(0,0,0,0.8));
        opacity: 0;
        transition: opacity 0.3s ease;
        display: flex;
        align-items: flex-end;
        padding: 1.5rem;
    }

    .gallery-card:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-content {
        color: white;
        transform: translateY(20px);
        transition: transform 0.3s ease;
    }

    .gallery-card:hover .gallery-content {
        transform: translateY(0);
    }

    .gallery-actions {
        position: absolute;
        top: 1rem;
        right: 1rem;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .gallery-card:hover .gallery-actions {
        opacity: 1;
    }

    .video-placeholder {
        cursor: pointer;
        transition: var(--transition);
    }

        .video-placeholder:hover {
            transform: scale(1.05);
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gallery filtering
        const filterButtons = document.querySelectorAll('[data-filter]');
        const galleryItems = document.querySelectorAll('.gallery-item');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                const filter = this.getAttribute('data-filter');

                // Update active button
                filterButtons.forEach(btn => {
                    btn.classList.remove('btn-primary');
                    btn.classList.add('btn-outline-primary');
                });
                this.classList.remove('btn-outline-primary');
                this.classList.add('btn-primary');

                // Filter items
                galleryItems.forEach(item => {
                    if (filter === 'all' || item.getAttribute('data-category') === filter) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Load more functionality
        const loadMoreBtn = document.getElementById('loadMore');
        let loadedItems = 8; // Starting with 8 items

        loadMoreBtn.addEventListener('click', function() {
            // Simulate loading more items
            const newItems = [
                { category: 'life', title: 'New Life Policy', description: 'Introducing our new life insurance packages' },
                { category: 'health', title: 'Corporate Health Plan', description: 'Health coverage for corporate employees' },
                { category: 'property', title: 'Business Property Coverage', description: 'Protecting businesses and assets against risks' }
            ];

            newItems.forEach((item, index) => {
                const newItem = document.createElement('div');
                newItem.className = 'gallery-item';
                newItem.setAttribute('data-category', item.category);
                newItem.innerHTML = `
                    <div class="gallery-card">
                        <img src="https://via.placeholder.com/400x300/6B7280/FFFFFF?text=New+Policy+${loadedItems + index + 1}" alt="${item.title}" class="img-fluid">
                        <div class="gallery-overlay">
                            <div class="gallery-content">
                                <h5 class="text-white mb-2">${item.title}</h5>
                                <p class="text-white mb-3">${item.description}</p>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-primary">${item.category.charAt(0).toUpperCase() + item.category.slice(1)}</span>
                                </div>
                            </div>
                        </div>
                        <div class="gallery-actions">
                            <a href="/Gallery/Details/${loadedItems + index + 1}" class="btn btn-sm btn-light">
                                <i class="fas fa-expand me-1"></i>View Details
                            </a>
                        </div>
                    </div>
                `;
                document.querySelector('.gallery-grid').appendChild(newItem);
            });

            loadedItems += newItems.length;

            if (loadedItems >= 15) {
                loadMoreBtn.disabled = true;
                loadMoreBtn.innerHTML = '<i class="fas fa-check me-2"></i>All Policies Loaded';
            }
        });

        // Video placeholder click
        document.querySelectorAll('.video-placeholder').forEach
