@{
    ViewData["Title"] = "Policy Details";
}
<!-- Hero Section -->
<section class="hero-section position-relative" style="min-height: 75vh;">
    <!-- Background Image -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-image: url('/images/programs/Details.jpg');
                background-size: cover;
                background-position: center;
                z-index: 1;">
    </div>

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0, 0, 0, 0.6); z-index: 2;">
    </div>

    <div class="container position-relative" style="z-index: 3;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold text-white mb-4">Comprehensive Life Insurance</h1>
                <p class="lead text-white mb-4">
                    Providing reliable life insurance coverage to protect your family’s future with confidence and peace of mind.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <div class="bg-white bg-opacity-25 rounded-pill px-3 py-2 text-white border border-white border-opacity-30 shadow-sm">
                        <i class="fas fa-map-marker-alt me-2"></i>Pakistan, UAE, UK
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-pill px-3 py-2 text-white border border-white border-opacity-30 shadow-sm">
                        <i class="fas fa-clock me-2"></i>Long-Term Coverage
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-pill px-3 py-2 text-white border border-white border-opacity-30 shadow-sm">
                        <i class="fas fa-users me-2"></i>10,000+ Policyholders
                    </div>
                </div>
            </div>

            <div class="col-lg-4 text-center">
                <!-- Insurance Summary Card -->
                <div class="bg-white rounded-4 p-4 shadow-lg border-0">
                    <h3 class="text-dark mb-3 fw-bold">Policy Coverage</h3>
                    <div class="progress mb-4" style="height: 12px; border-radius: 10px; background: #f1f5f9;">
                        <div class="progress-bar rounded-pill" style="width: 75%; background: linear-gradient(135deg, #0D8ABC 0%, #0A6A94 100%);">
                            <div class="progress-shimmer"></div>
                        </div>
                    </div>
                    <div class="text-dark mb-4">
                        <span class="h2 fw-bold text-dark d-block">75%</span>
                        <span class="text-muted">coverage utilization rate</span>
                    </div>
                    <a href="/User/Donate" class="btn btn-primary btn-lg w-100 py-3 fw-semibold shadow-sm border-0 mb-2"
                       style="background: linear-gradient(135deg, #0D8ABC 0%, #0A6A94 100%);">
                        <i class="fas fa-file-contract me-2"></i>Get This Policy
                    </a>
                    <div class="text-center">
                        <small class="text-muted">
                            <i class="fas fa-shield-alt me-1"></i>Secure & Trusted Insurance Provider
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Policy Details -->
<section class="section-padding bg-white pt-5 pb-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-5">
                        <h4 class="mb-4 text-dark fw-bold">About This Insurance Plan</h4>
                        <p class="mb-4 text-muted lead">
                            HM Insurance’s Life Protection Plan is designed to secure your loved ones financially in case of unexpected events. Our goal is to offer dependable coverage, flexible options, and long-term financial security.
                        </p>

                        <h5 class="mb-3 text-dark fw-semibold">Key Benefits</h5>
                        <ul class="list-unstyled mb-4">
                            <li class="mb-3 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <i class="fas fa-check text-primary me-2"></i>Comprehensive life coverage
                            </li>
                            <li class="mb-3 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <i class="fas fa-check text-primary me-2"></i>Affordable premium plans
                            </li>
                            <li class="mb-3 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <i class="fas fa-check text-primary me-2"></i>Family financial protection
                            </li>
                            <li class="mb-3 p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <i class="fas fa-check text-primary me-2"></i>Flexible policy terms
                            </li>
                            <li class="p-3 bg-light rounded-3 border-start border-4 border-primary">
                                <i class="fas fa-check text-primary me-2"></i>Quick and transparent claim process
                            </li>
                        </ul>

                        <h5 class="mb-3 text-dark fw-semibold">Our Impact</h5>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4 text-center">
                                <div class="bg-primary-light rounded-4 p-4 border border-primary border-opacity-10 shadow-sm">
                                    <h3 class="text-primary mb-2 fw-bold">10,000+</h3>
                                    <p class="text-muted mb-0 fw-medium">Active Policies</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-primary-light rounded-4 p-4 border border-primary border-opacity-10 shadow-sm">
                                    <h3 class="text-primary mb-2 fw-bold">99%</h3>
                                    <p class="text-muted mb-0 fw-medium">Claim Success Rate</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-primary-light rounded-4 p-4 border border-primary border-opacity-10 shadow-sm">
                                    <h3 class="text-primary mb-2 fw-bold">15+</h3>
                                    <p class="text-muted mb-0 fw-medium">Years of Trust</p>
                                </div>
                            </div>
                        </div>

                        <h5 class="mb-3 text-dark fw-semibold">Policy Timeline</h5>
                        <div class="card bg-light border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white rounded-3">
                                    <span class="fw-medium">Policy Launch</span>
                                    <span class="fw-bold text-primary">January 2010</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-white rounded-3">
                                    <span class="fw-medium">Current Status</span>
                                    <span class="fw-bold text-primary">Active & Expanding</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center p-3 bg-white rounded-3">
                                    <span class="fw-medium">Renewal Period</span>
                                    <span class="fw-bold text-primary">Annual / Long-Term</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Quick Facts -->
                <div class="card border-0 shadow-lg mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>Policy Overview</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3 pb-3 border-bottom">
                            <small class="text-muted fw-semibold">COVERAGE AREA</small>
                            <div class="fw-medium text-dark">Pakistan, UAE, UK</div>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <small class="text-muted fw-semibold">POLICY TERM</small>
                            <div class="fw-medium text-dark">5–30 Years</div>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <small class="text-muted fw-semibold">BENEFICIARIES</small>
                            <div class="fw-medium text-dark">Families & Individuals</div>
                        </div>
                        <div class="mb-3 pb-3 border-bottom">
                            <small class="text-muted fw-semibold">INSURER</small>
                            <div class="fw-medium text-dark">HM Insurance Company</div>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted fw-semibold">STATUS</small>
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fw-medium">
                                    Available
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gallery Preview -->
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-images me-2"></i>Company Highlights</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-4"><img src="/images/programs/insurance-About.jpg" class="img-fluid w-100 rounded-3"></div>
                            <div class="col-4"><img src="/images/programs/Life Insurance.jpg" class="img-fluid w-100 rounded-3"></div>
                            <div class="col-4"><img src="/images/programs/Asset Insurance.jpg" class="img-fluid w-100 rounded-3"></div>
                            <div class="col-4"><img src="/images/programs/Health Insurance.jpg" class="img-fluid w-100 rounded-3"></div>
                            <div class="col-4"><img src="/images/programs/insurance-Contact.jpg" class="img-fluid w-100 rounded-3"></div>
                            <div class="col-4"><img src="/images/programs/insurance-policy.jpg" class="img-fluid w-100 rounded-3"></div>
                        </div>
                        <a href="/Gallery" class="btn btn-outline-primary w-100 py-2 fw-semibold">
                            <i class="fas fa-images me-2"></i>View Company Gallery
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
