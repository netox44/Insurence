@{
    ViewData["Title"] = "Our Insurance Plans - HM Insurance";
}
<!-- Hero Section -->
<section class="position-relative text-white"
         style="
        background-image: url('/images/programs/insurance-policy.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 75vh;
    ">

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100"
         style="background-color: rgba(0,0,0,0.55);">
    </div>

    <!-- Centered Content -->
    <div class="position-relative d-flex align-items-center justify-content-center text-center"
         style="min-height: 75vh;">
        <div class="container">
            <h1 class="display-4 fw-bold mb-4 mx-auto">
                Our Insurance Plans
            </h1>
            <p class="mb-0 mx-auto">
                Explore our trusted insurance solutions designed to protect your life, health, and assets
            </p>
        </div>
    </div>
</section>
<!-- Programs Grid -->
<section class="section-padding bg-white mt-5 pb-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Featured Insurance Policies</h2>
                <p class="lead text-muted">
                    Each policy is carefully designed to provide reliable coverage and long-term financial security
                </p>
            </div>
        </div>

        <div class="row g-4">

            <!-- Life Insurance -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100">
                    <img src="/images/programs/Health Insurance.jpg" class="card-img-top" alt="Life Insurance">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">Life Insurance Plan</h5>
                            <span class="badge bg-primary">Life</span>
                        </div>
                        <p class="card-text text-muted">
                            Ensure your family’s financial stability with comprehensive life insurance coverage
                            offering long-term protection and peace of mind.
                        </p>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 75%"></div>
                        </div>
                        <div class="d-flex justify-content-between text-sm text-muted mb-3">
                            <span>High Coverage</span>
                            <span>Flexible Premiums</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-users me-1"></i>Trusted by 450+ clients
                            </small>
                            <div class="btn-group">
                                <a href="/User/Donate" class="btn btn-primary btn-sm">
                                    <i class="fas fa-donate me-1"></i>Apply
                                </a>
                                <a href="/Program/Details/1" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Health Insurance -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100">
                    <img src="/images/programs/Life Insurance.jpg" class="card-img-top" alt="Health Insurance">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">Health Insurance Plan</h5>
                            <span class="badge bg-success">Health</span>
                        </div>
                        <p class="card-text text-muted">
                            Get complete medical coverage including hospitalization, emergency care,
                            and essential health services for you and your family.
                        </p>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 60%"></div>
                        </div>
                        <div class="d-flex justify-content-between text-sm text-muted mb-3">
                            <span>Nationwide Coverage</span>
                            <span>Cashless Treatment</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-users me-1"></i>Trusted by 680+ clients
                            </small>
                            <div class="btn-group">
                                <a href="/User/Donate" class="btn btn-primary btn-sm">
                                    <i class="fas fa-donate me-1"></i>Apply
                                </a>
                                <a href="/Program/Details/2" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Property Insurance -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100">
                    <img src="/images/programs/Asset Insurance.jpg" class="card-img-top" alt="Property Insurance">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title">Property & Asset Insurance</h5>
                            <span class="badge bg-warning">Assets</span>
                        </div>
                        <p class="card-text text-muted">
                            Protect your home, property, and valuable assets against damage,
                            theft, and unforeseen risks with reliable insurance coverage.
                        </p>
                        <div class="progress mb-3">
                            <div class="progress-bar" style="width: 45%"></div>
                        </div>
                        <div class="d-flex justify-content-between text-sm text-muted mb-3">
                            <span>Secure Assets</span>
                            <span>Risk Protection</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-users me-1"></i>Trusted by 320+ clients
                            </small>
                            <div class="btn-group">
                                <a href="/User/Donate" class="btn btn-primary btn-sm">
                                    <i class="fas fa-donate me-1"></i>Apply
                                </a>
                                <a href="/Program/Details/3" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Program Categories -->
<section class="section-padding bg-light mt-5">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="display-5 fw-bold mb-3">Insurance Categories</h2>
                <p class="lead text-muted">
                    HM Insurance offers a wide range of coverage solutions for individuals and businesses
                </p>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body p-4">
                        <i class="fas fa-graduation-cap fa-3x text-primary mb-3"></i>
                        <h5>Life Insurance</h5>
                        <p class="text-muted">Financial protection and long-term family security</p>
                        <span class="badge bg-primary">4 Plans</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body p-4">
                        <i class="fas fa-heartbeat fa-3x text-success mb-3"></i>
                        <h5>Health Insurance</h5>
                        <p class="text-muted">Medical coverage, hospitalization, and emergency care</p>
                        <span class="badge bg-success">3 Plans</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body p-4">
                        <i class="fas fa-leaf fa-3x text-warning mb-3"></i>
                        <h5>Asset Insurance</h5>
                        <p class="text-muted">Home, property, and valuable asset protection</p>
                        <span class="badge bg-warning">2 Plans</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm text-center h-100">
                    <div class="card-body p-4">
                        <i class="fas fa-home fa-3x text-info mb-3"></i>
                        <h5>Business Insurance</h5>
                        <p class="text-muted">Business, commercial, and liability coverage</p>
                        <span class="badge bg-info">3 Plans</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
